# ------------------------------------------------------------------
# Kopieren nach ".env" (lokal) bzw. in Netlify unter
# Site configuration -> Environment variables eintragen.
# Alle PUBLIC_-Variablen landen im Browser-Code – keine Geheimnisse hier.
# ------------------------------------------------------------------

# Öffentliche Domain (ohne Slash am Ende)
PUBLIC_SITE_URL=https://www.ideale-gebaeudereinigung.de

# Google Tag Manager – wird nur geladen, wenn gesetzt (z. B. GTM-XXXXXXX)
PUBLIC_GTM_ID=

# Optional: direkte Google-Ads-Conversion ohne GTM (z. B. AW-123456789)
PUBLIC_ADS_CONVERSION_ID=
# Conversion-Labels (Teil hinter dem Schrägstrich in send_to)
PUBLIC_ADS_LABEL_FORMULAR=
PUBLIC_ADS_LABEL_ANRUF=
PUBLIC_ADS_LABEL_WHATSAPP=

# Optional: Google Analytics 4 (G-XXXXXXXXXX) – nur mit Datenschutz-Abschnitt!
PUBLIC_GA4_ID=
