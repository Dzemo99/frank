---
import { Icon } from 'astro-icon/components';
import type { Faq } from '../data/services';

interface Props {
  items: Faq[];
  title?: string;
  eyebrow?: string;
}
const { items, title = 'Häufige Fragen', eyebrow = 'FAQ' } = Astro.props;
---

<section class="section bg-mist-50">
  <div class="container-x grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-3 text-display-md">{title}</h2>
      <p class="mt-3 text-navy-700">Ihre Frage ist nicht dabei? Rufen Sie uns an oder schreiben Sie uns – wir antworten schnell und konkret.</p>
      <a href="/kontakt" class="btn-ghost mt-5">Zum Kontakt <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
    </div>
    <div class="space-y-3 lg:col-span-8" data-reveal-group>
      {items.map((f, i) => (
        <details class="faq card overflow-hidden" name="faq" open={i === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 text-left font-semibold text-navy-950 sm:p-6">
            <span>{f.q}</span>
            <span class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-900 transition-transform duration-300">
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 2v12M2 8h12" /></svg>
            </span>
          </summary>
          <div class="faq-body px-5 pb-5 text-navy-700 sm:px-6 sm:pb-6">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
