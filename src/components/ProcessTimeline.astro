---
/** Interaktive Timeline: 1. Anfrage → 2. Besichtigung → 3. Konzept → 4. Start */
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;

const steps = [
  {
    icon: 'lucide:send',
    title: 'Anfrage',
    time: 'Tag 0',
    text: 'Sie senden uns in 60 Sekunden Leistung, Fläche und Kontaktdaten – oder rufen einfach an. Wir melden uns in der Regel innerhalb eines Werktags.',
  },
  {
    icon: 'lucide:eye',
    title: 'Besichtigung',
    time: 'Kostenlos & vor Ort',
    text: 'Unsere Objektleitung sieht sich Ihre Flächen an, klärt Zugänge, Zeiten und Besonderheiten und nimmt Ihre Anforderungen auf.',
  },
  {
    icon: 'lucide:file-text',
    title: 'Individuelles Konzept',
    time: 'Angebot & Leistungsverzeichnis',
    text: 'Sie erhalten ein klares Angebot mit Leistungsverzeichnis, Intervallen und festen Ansprechpersonen – ohne versteckte Kosten.',
  },
  {
    icon: 'lucide:rocket',
    title: 'Start',
    time: 'Einweisung & Qualitätskontrolle',
    text: 'Ihr festes Team wird im Objekt eingewiesen. Ab dem ersten Tag dokumentieren wir digital und prüfen die Qualität regelmäßig.',
  },
];
---

<section class="section bg-white" id="ablauf">
  <div class="container-x">
    {heading && (
      <SectionHeading
        align="center"
        eyebrow="So läuft es ab"
        title="In vier Schritten zur sauberen Lösung"
        text="Von der Anfrage bis zum ersten Reinigungstag: transparent, planbar und ohne Aufwand für Sie."
      />
    )}

    <div class="relative mx-auto mt-14 max-w-4xl" data-timeline>
      <!-- Linie -->
      <div class="absolute left-6 top-0 h-full w-px bg-navy-100 md:left-1/2 md:-translate-x-1/2" aria-hidden="true">
        <div class="timeline-line h-full w-full bg-accent-gradient"></div>
      </div>

      <ol class="space-y-10 md:space-y-16">
        {steps.map((s, i) => (
          <li class="timeline-step relative pl-16 md:grid md:grid-cols-2 md:gap-16 md:pl-0" data-timeline-step>
            <!-- Punkt -->
            <span
              class="absolute left-6 top-1 flex h-12 w-12 -translate-x-1/2 items-center justify-center rounded-full border-4 border-white bg-navy-100 text-navy-500 shadow-soft transition-colors duration-500 md:left-1/2"
              data-timeline-dot
            >
              <Icon name={s.icon} class="h-5 w-5" />
            </span>
            <div class:list={['card p-6 transition-all duration-500', i % 2 === 0 ? 'md:col-start-1 md:text-right' : 'md:col-start-2']}>
              <span class="inline-flex items-center gap-2 rounded-full bg-accent-50 px-3 py-1 text-xs font-semibold text-accent-700">
                Schritt {i + 1} · {s.time}
              </span>
              <h3 class="mt-3 text-xl font-bold text-navy-950">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-700">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline-step.is-active [data-timeline-dot] {
    @apply bg-navy-950 text-accent-300;
  }
  .timeline-step.is-active .card {
    @apply border-accent-200 shadow-lift;
  }
</style>
