---
import { Icon } from 'astro-icon/components';
import { site, ctaLabel } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  button?: string;
  href?: string;
}
const {
  title = 'Bereit für ein sauberes Objekt?',
  text = 'Fordern Sie jetzt Ihr unverbindliches Angebot an – oder sprechen Sie direkt mit uns.',
  button = ctaLabel,
  href = '/#anfrage',
} = Astro.props;
---

<section class="section-tight">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-4xl bg-navy-900 px-6 py-12 text-white shadow-lift sm:px-12 lg:px-16" data-reveal>
      <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-accent-500/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 left-1/3 h-72 w-72 rounded-full bg-electric-600/20 blur-3xl"></div>
      <div class="relative grid items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-display-md text-white">{title}</h2>
          <p class="mt-3 text-white/75">{text}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
          <a href={href} class="btn-primary btn-lg">{button} <Icon name="lucide:arrow-right" class="h-5 w-5" /></a>
          <a href={site.phone.href} data-place="cta-banner" class="btn-outline-light btn-lg"><Icon name="lucide:phone" class="h-5 w-5" /> Anrufen</a>
        </div>
      </div>
    </div>
  </div>
</section>
