---
/**
 * MULTI-STEP-FORMULAR "Angebot in 60 Sekunden"
 * Leistung → Objekt & Fläche → Kontaktdaten → Absenden
 * Netlify Forms (name="angebot"), Honeypot, Datenschutz-Checkbox.
 * Logik: src/scripts/multistep-form.ts
 */
import { Icon } from 'astro-icon/components';
import { formServiceOptions } from '../data/services';
import { site } from '../data/site';

interface Props {
  /** Vorausgewählte Leistung (Landingpages) */
  defaultService?: string;
  title?: string;
  text?: string;
  id?: string;
}
const {
  defaultService,
  title = 'Angebot in 60 Sekunden anfragen',
  text = 'Drei kurze Schritte – danach melden wir uns mit einem Termin für die kostenlose Besichtigung.',
  id = 'anfrage',
} = Astro.props;

const areaOptions = ['bis 250 m²', '250 – 1.000 m²', '1.000 – 5.000 m²', 'über 5.000 m²', 'Noch unklar'];
const intervalOptions = ['Täglich', 'Mehrmals pro Woche', 'Wöchentlich', 'Alle 2 Wochen / monatlich', 'Einmalig / nach Bedarf'];
const steps = ['Leistung', 'Objekt', 'Kontakt'];
---

<section class="section relative overflow-hidden bg-navy-950 text-white" id={id}>
  <div class="pointer-events-none absolute -left-24 bottom-0 h-96 w-96 rounded-full bg-accent-500/15 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-24 top-0 h-96 w-96 rounded-full bg-electric-600/15 blur-3xl"></div>

  <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow eyebrow-light">Unverbindlich & kostenlos</p>
      <h2 class="mt-3 text-display-lg text-white">{title}</h2>
      <p class="mt-4 text-lg text-white/75">{text}</p>
      <ul class="mt-8 space-y-4 text-sm text-white/80">
        {[
          ['lucide:timer', 'Rückmeldung in der Regel innerhalb eines Werktags'],
          ['lucide:eye', 'Kostenlose Besichtigung – wir schauen uns Ihr Objekt an'],
          ['lucide:file-text', 'Transparentes Angebot mit Leistungsverzeichnis'],
          ['lucide:lock', 'Ihre Daten werden ausschließlich zur Bearbeitung der Anfrage genutzt'],
        ].map(([icon, label]) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-500/20 text-accent-300"><Icon name={icon!} class="h-4 w-4" /></span>
            <span>{label}</span>
          </li>
        ))}
      </ul>
      <div class="mt-10 rounded-2xl border border-white/10 bg-white/5 p-5">
        <p class="text-sm text-white/60">Lieber direkt sprechen?</p>
        <a href={site.phone.href} data-place="form" class="mt-1 inline-flex items-center gap-2 text-xl font-bold text-white hover:text-accent-300">
          <Icon name="lucide:phone" class="h-5 w-5 text-accent-300" /> {site.phone.display}
        </a>
        <p class="mt-1 text-xs text-white/50">{site.openingHours}</p>
      </div>
    </div>

    <div class="lg:col-span-7" data-reveal>
      <form
        name="angebot"
        method="POST"
        action="/danke"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-multistep
        data-redirect="/danke"
        class="rounded-4xl bg-white p-6 text-navy-900 shadow-lift sm:p-8"
        novalidate
      >
        <input type="hidden" name="form-name" value="angebot" />
        <input type="hidden" name="quelle" value={Astro.url.pathname} />
        <p class="hidden">
          <label>Bitte dieses Feld leer lassen: <input name="bot-field" /></label>
        </p>

        <!-- Fortschritt -->
        <div class="form-progress">
          <ol class="flex items-center justify-between gap-2 text-xs font-semibold">
            {steps.map((label, i) => (
              <li class="progress-step flex flex-1 items-center gap-2" data-progress-step>
                <span class="progress-dot flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-navy-200 text-navy-500 transition-colors">{i + 1}</span>
                <span class="progress-label hidden text-navy-600 sm:inline">{label}</span>
              </li>
            ))}
          </ol>
          <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-navy-100">
            <div class="h-full rounded-full bg-accent-gradient transition-all duration-500 ease-spring" style="width:33%" data-progress-bar></div>
          </div>
        </div>

        <!-- Schritt 1: Leistung -->
        <fieldset class="form-step mt-6" data-field="leistung">
          <legend class="text-lg font-bold text-navy-950">Welche Leistung benötigen Sie?</legend>
          <p class="mt-1 text-sm text-navy-600">Eine Auswahl genügt – Kombinationen besprechen wir bei der Besichtigung.</p>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            {formServiceOptions.map((opt, i) => (
              <label class="choice">
                <input type="radio" name="leistung" value={opt.value} required checked={defaultService === opt.value} data-autoadvance aria-describedby={i === 0 ? 'leistung-error' : undefined} />
                <span class="choice-icon"><Icon name={opt.icon} class="h-5 w-5" /></span>
                <span class="text-sm font-semibold">{opt.label}</span>
                <Icon name="lucide:check" class="ml-auto h-4 w-4 text-electric-600 opacity-0 transition-opacity [.choice:has(input:checked)_&]:opacity-100" />
              </label>
            ))}
          </div>
          <p class="field-error" id="leistung-error">Bitte wählen Sie eine Leistung aus.</p>
          <div class="form-nav-js mt-6 flex justify-end">
            <button type="button" class="btn-dark" data-next>Weiter <Icon name="lucide:arrow-right" class="h-4 w-4" /></button>
          </div>
        </fieldset>

        <!-- Schritt 2: Objekt & Fläche -->
        <fieldset class="form-step mt-6" style="display:none">
          <legend class="text-lg font-bold text-navy-950">Wie groß ist die Fläche?</legend>
          <p class="mt-1 text-sm text-navy-600">Eine grobe Schätzung reicht völlig aus.</p>

          <div class="mt-5" data-field="flaeche">
            <div class="grid gap-2 sm:grid-cols-2">
              {areaOptions.map((opt) => (
                <label class="choice py-3">
                  <input type="radio" name="flaeche" value={opt} required />
                  <span class="choice-icon h-8 w-8 rounded-lg"><Icon name="lucide:ruler" class="h-4 w-4" /></span>
                  <span class="text-sm font-semibold">{opt}</span>
                </label>
              ))}
            </div>
            <p class="field-error">Bitte wählen Sie eine Flächengröße.</p>
          </div>

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div data-field="flaeche_exakt">
              <label for="flaeche_exakt" class="label">Genaue Fläche in m² <span class="font-normal text-navy-500">(optional)</span></label>
              <input id="flaeche_exakt" name="flaeche_exakt" type="number" inputmode="numeric" min="1" max="1000000" class="input" placeholder="z. B. 1.200" />
              <p class="field-error">Bitte eine gültige Zahl eingeben.</p>
            </div>
            <div data-field="intervall">
              <label for="intervall" class="label">Gewünschter Rhythmus</label>
              <select id="intervall" name="intervall" class="input" required>
                <option value="">Bitte wählen …</option>
                {intervalOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
              <p class="field-error">Bitte wählen Sie einen Rhythmus.</p>
            </div>
          </div>
          <div class="mt-4" data-field="objekt_ort">
            <label for="objekt_ort" class="label">Ort / PLZ des Objekts</label>
            <input id="objekt_ort" name="objekt_ort" type="text" class="input" placeholder="z. B. 60311 Frankfurt am Main" required autocomplete="off" />
            <p class="field-error">Bitte geben Sie den Ort des Objekts an.</p>
          </div>

          <div class="form-nav-js mt-6 flex items-center justify-between gap-3">
            <button type="button" class="btn-ghost" data-prev><Icon name="lucide:chevron-left" class="h-4 w-4" /> Zurück</button>
            <button type="button" class="btn-dark" data-next>Weiter <Icon name="lucide:arrow-right" class="h-4 w-4" /></button>
          </div>
        </fieldset>

        <!-- Schritt 3: Kontakt -->
        <fieldset class="form-step mt-6" style="display:none">
          <legend class="text-lg font-bold text-navy-950">Wohin dürfen wir uns melden?</legend>

          <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 rounded-2xl bg-mist-100 p-4 text-sm [&_dd]:font-semibold [&_dd]:text-navy-950 [&_dt]:text-navy-500" data-summary></dl>

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div data-field="firma">
              <label for="firma" class="label">Firma</label>
              <input id="firma" name="firma" type="text" class="input" autocomplete="organization" required />
              <p class="field-error">Bitte geben Sie Ihre Firma an.</p>
            </div>
            <div data-field="name">
              <label for="name" class="label">Ansprechpartner/in</label>
              <input id="name" name="name" type="text" class="input" autocomplete="name" required />
              <p class="field-error">Bitte geben Sie Ihren Namen an.</p>
            </div>
            <div data-field="telefon">
              <label for="telefon" class="label">Telefon</label>
              <input id="telefon" name="telefon" type="tel" class="input" autocomplete="tel" inputmode="tel" required pattern="^[+0-9 ()/.-]{6,}$" />
              <p class="field-error">Bitte geben Sie eine gültige Telefonnummer an.</p>
            </div>
            <div data-field="email">
              <label for="email" class="label">E-Mail</label>
              <input id="email" name="email" type="email" class="input" autocomplete="email" inputmode="email" required />
              <p class="field-error">Bitte geben Sie eine gültige E-Mail-Adresse an.</p>
            </div>
          </div>
          <div class="mt-4" data-field="nachricht">
            <label for="nachricht" class="label">Nachricht <span class="font-normal text-navy-500">(optional)</span></label>
            <textarea id="nachricht" name="nachricht" rows="3" class="input" placeholder="Besonderheiten, Wunschtermin, Zugang zum Objekt …"></textarea>
          </div>

          <div class="mt-5" data-field="datenschutz">
            <label class="flex items-start gap-3 text-sm text-navy-700">
              <input type="checkbox" name="datenschutz" value="ja" class="checkbox" required />
              <span>Ich habe die <a href="/datenschutz" class="font-semibold text-electric-600 underline underline-offset-2" target="_blank">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Bearbeitung der Anfrage einverstanden.</span>
            </label>
            <p class="field-error">Bitte stimmen Sie der Datenschutzerklärung zu.</p>
          </div>

          <p class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm text-red-700" role="alert" data-form-status></p>

          <div class="mt-6 flex flex-col-reverse items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" class="btn-ghost form-nav-js justify-center" data-prev><Icon name="lucide:chevron-left" class="h-4 w-4" /> Zurück</button>
            <button type="submit" class="btn-primary btn-lg">Anfrage absenden <Icon name="lucide:send" class="h-5 w-5" /></button>
          </div>
          <p class="mt-3 text-center text-xs text-navy-500 sm:text-right">Kostenlos & unverbindlich. Kein Newsletter.</p>
        </fieldset>
      </form>
    </div>
  </div>
</section>

<style>
  .progress-step.is-active .progress-dot {
    @apply border-electric-500 bg-electric-500 text-white;
  }
  .progress-step.is-done .progress-dot {
    @apply border-accent-400 bg-accent-400 text-navy-950;
  }
  .progress-step.is-active .progress-label {
    @apply text-navy-950;
  }
</style>
