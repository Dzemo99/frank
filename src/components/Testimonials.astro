---
/**
 * KUNDENSTIMMEN – zeigt nur veröffentlichte Einträge (published: true).
 * Im Dev-Modus werden Platzhalter zur Vorschau eingeblendet und als solche markiert.
 */
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import BeforeAfterSlider from './BeforeAfterSlider.astro';
import { testimonials, beforeAfter } from '../data/testimonials';

const isDev = import.meta.env.DEV;
const shownTestimonials = testimonials.filter((t) => t.published || isDev);
const shownBeforeAfter = beforeAfter.filter((b) => b.published || isDev);
const hasContent = shownTestimonials.length > 0 || shownBeforeAfter.length > 0;
---

{hasContent && (
  <section class="section bg-white" id="referenzen">
    <div class="container-x">
      <SectionHeading
        align="center"
        eyebrow="Ergebnisse, die man sieht"
        title="Das sagen Kunden – das zeigen unsere Flächen"
        text="Echte Stimmen aus Frankfurt und der Region sowie dokumentierte Vorher/Nachher-Ergebnisse aus unseren Objekten."
      />

      {isDev && (
        <p class="mx-auto mt-6 max-w-2xl rounded-xl border border-amber-200 bg-amber-50 p-3 text-center text-xs text-amber-900">
          <strong>Nur in der Entwicklung sichtbar:</strong> Platzhalter-Inhalte. Im Produktiv-Build erscheint dieser Abschnitt erst,
          wenn in <code>src/data/testimonials.ts</code> Einträge auf <code>published: true</code> stehen.
        </p>
      )}

      {shownBeforeAfter.length > 0 && (
        <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-center">
          {shownBeforeAfter.slice(0, 1).map((item) => (
            <>
              <div data-reveal>
                <BeforeAfterSlider before={item.before} after={item.after} title={item.title} />
              </div>
              <div data-reveal>
                <p class="eyebrow">Vorher / Nachher</p>
                <h3 class="mt-3 text-display-md">{item.title}</h3>
                <p class="mt-3 text-navy-700">{item.description}</p>
                <p class="mt-6 inline-flex items-center gap-2 text-sm text-navy-500">
                  <Icon name="lucide:move-horizontal" class="h-4 w-4" /> Regler ziehen, um den Unterschied zu sehen
                </p>
              </div>
            </>
          ))}
        </div>
      )}

      {shownTestimonials.length > 0 && (
        <ul class="mt-14 grid gap-5 md:grid-cols-3" data-reveal-group>
          {shownTestimonials.map((t) => (
            <li class="card flex flex-col p-6">
              <Icon name="lucide:quote" class="h-7 w-7 text-accent-400" />
              {t.rating && (
                <div class="mt-3 flex gap-0.5 text-amber-400" aria-label={`${t.rating} von 5 Sternen`}>
                  {Array.from({ length: t.rating }).map(() => <Icon name="lucide:star" class="h-4 w-4 fill-current" />)}
                </div>
              )}
              <blockquote class="mt-3 flex-1 text-navy-800">„{t.quote}“</blockquote>
              <footer class="mt-5 border-t border-navy-100 pt-4 text-sm">
                <p class="font-bold text-navy-950">{t.name}</p>
                <p class="text-navy-600">{t.role}</p>
                {t.source && <p class="mt-1 text-xs text-navy-400">{t.source}</p>}
              </footer>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
