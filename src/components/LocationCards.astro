---
/** Standorte + Click-to-Load-Karte (Google Maps erst nach Klick) */
import { Icon } from 'astro-icon/components';
import { locations, site } from '../data/site';

interface Props {
  withMap?: boolean;
}
const { withMap = true } = Astro.props;
const frankfurt = locations.find((l) => l.id === 'frankfurt')!;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(
  frankfurt.street.startsWith('[') ? `${site.name} ${frankfurt.city}` : `${frankfurt.street}, ${frankfurt.zip} ${frankfurt.city}`,
)}&output=embed&hl=de`;
---

<div class="grid gap-6 lg:grid-cols-12">
  <ul class="space-y-4 lg:col-span-5" data-reveal-group>
    {locations.map((l) => (
      <li class="card p-6">
        <div class="flex items-start gap-4">
          <span class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-xl', l.isPrimary ? 'bg-navy-950 text-accent-300' : 'bg-navy-50 text-navy-800']}>
            <Icon name={l.isPrimary ? 'lucide:map-pin' : 'lucide:briefcase'} class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-bold text-navy-950">{l.label}</h3>
            <p class="mt-0.5 text-sm text-navy-600">{l.role}</p>
            <address class="mt-3 text-sm not-italic text-navy-800">
              {l.street}<br />
              {l.zip} {l.city}
            </address>
          </div>
        </div>
      </li>
    ))}
    <li class="card p-6">
      <h3 class="font-bold text-navy-950">Erreichbarkeit</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={site.phone.href} data-place="kontakt" class="inline-flex items-center gap-2 font-semibold text-navy-900 hover:text-electric-600"><Icon name="lucide:phone" class="h-4 w-4" /> {site.phone.display}</a></li>
        <li><a href={site.whatsapp.href} data-place="kontakt" target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold text-navy-900 hover:text-electric-600"><Icon name="lucide:message-circle" class="h-4 w-4" /> WhatsApp {site.whatsapp.display}</a></li>
        <li><a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 font-semibold text-navy-900 hover:text-electric-600"><Icon name="lucide:mail" class="h-4 w-4" /> {site.email}</a></li>
        <li class="inline-flex items-center gap-2 text-navy-600"><Icon name="lucide:clock" class="h-4 w-4" /> {site.openingHours}</li>
      </ul>
    </li>
  </ul>

  {withMap && (
    <div class="lg:col-span-7" data-reveal>
      <div
        class="relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-4xl border border-navy-100 bg-navy-50 bg-grid-light bg-[size:32px_32px] lg:aspect-auto lg:h-full lg:min-h-[420px]"
        data-map
        data-map-src={mapSrc}
        data-map-title={`Karte: ${frankfurt.label}`}
      >
        <div class="max-w-sm p-6 text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-navy-900 shadow-soft"><Icon name="lucide:map-pin" class="h-7 w-7" /></span>
          <p class="mt-4 font-bold text-navy-950">Karte anzeigen</p>
          <p class="mt-1 text-sm text-navy-600">
            Beim Laden der Karte werden Daten an Google übertragen (Google Maps). Details in der
            <a href="/datenschutz" class="font-semibold text-electric-600 underline underline-offset-2">Datenschutzerklärung</a>.
          </p>
          <button type="button" class="btn-dark btn-sm mt-4" data-map-load>Google Maps laden <Icon name="lucide:external-link" class="h-4 w-4" /></button>
        </div>
      </div>
    </div>
  )}
</div>
