---
/** IMPRESSUM – PLATZHALTER. Alle [TODO]-Stellen vor Livegang befüllen. */
import Layout from '../layouts/Layout.astro';
import { site, locations } from '../data/site';
const goettingen = locations.find((l) => l.id === 'goettingen')!;
const frankfurt = locations.find((l) => l.id === 'frankfurt')!;
---

<Layout title="Impressum" description="Impressum der Ideale Gebäudereinigung." canonical="/impressum" noindex hideMobileBar>
  <section class="section bg-white">
    <div class="container-x prose-legal">
      <p class="eyebrow">Rechtliches</p>
      <h1 class="mt-3 text-display-lg">Impressum</h1>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        <strong>{site.legalName.startsWith('[') ? <span class="todo">{site.legalName}</span> : site.legalName}</strong><br />
        <span class="todo">[Rechtsform, z. B. GmbH / Einzelunternehmen]</span><br />
        {goettingen.street.startsWith('[') ? <span class="todo">{goettingen.street}</span> : goettingen.street}<br />
        {goettingen.zip.startsWith('[') ? <span class="todo">{goettingen.zip}</span> : goettingen.zip} {goettingen.city}
      </p>
      <p>
        <strong>Niederlassung Frankfurt am Main</strong><br />
        {frankfurt.street.startsWith('[') ? <span class="todo">{frankfurt.street}</span> : frankfurt.street}<br />
        {frankfurt.zip.startsWith('[') ? <span class="todo">{frankfurt.zip}</span> : frankfurt.zip} {frankfurt.city}
      </p>

      <h2>Vertreten durch</h2>
      <p><span class="todo">[Vorname Nachname, Geschäftsführer/in bzw. Inhaber/in]</span></p>

      <h2>Kontakt</h2>
      <p>
        Telefon: <a href={site.phone.href}>{site.phone.display}</a><br />
        E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>

      <h2>Registereintrag</h2>
      <p>
        <span class="todo">[Registergericht, z. B. Amtsgericht Göttingen]</span><br />
        <span class="todo">[Registernummer, z. B. HRB 000000]</span> – entfällt bei Einzelunternehmen ohne Handelsregistereintrag.
      </p>

      <h2>Umsatzsteuer-ID</h2>
      <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: <span class="todo">[DE 000 000 000]</span></p>

      <h2>Berufsbezeichnung / Handwerksrolle</h2>
      <p>Gebäudereiniger-Handwerk. <span class="todo">[Eintrag in die Handwerksrolle bei der Handwerkskammer …, Betriebsnummer …]</span></p>

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p><span class="todo">[Vorname Nachname, Anschrift]</span></p>

      <h2>EU-Streitschlichtung</h2>
      <p>
        Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
        <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener">https://ec.europa.eu/consumers/odr/</a>.
        Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
      </p>

      <h2>Bildnachweise</h2>
      <p><span class="todo">[Urheber / Quelle der verwendeten Fotos und Grafiken eintragen]</span></p>
    </div>
  </section>
</Layout>
