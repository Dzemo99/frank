---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';
---

<Layout title="Seite nicht gefunden" description="Diese Seite existiert nicht." noindex>
  <section class="section bg-mist-50">
    <div class="container-x text-center">
      <p class="eyebrow justify-center">Fehler 404</p>
      <h1 class="mt-3 text-display-lg">Diese Seite haben wir leider nicht gefunden.</h1>
      <p class="mt-4 lead mx-auto max-w-xl">Vielleicht hilft eine unserer Leistungsseiten weiter – oder Sie starten direkt eine Anfrage.</p>
      <ul class="mx-auto mt-8 flex max-w-2xl flex-wrap justify-center gap-2">
        {services.map((s) => <li><a href={`/leistungen/${s.slug}`} class="chip hover:border-accent-300">{s.name}</a></li>)}
      </ul>
      <a href="/" class="btn-dark mt-10">Zur Startseite <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
    </div>
  </section>
</Layout>
