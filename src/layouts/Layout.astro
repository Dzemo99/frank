---
/**
 * BASIS-LAYOUT
 * SEO-Meta, OpenGraph, Schema.org (LocalBusiness mit beiden Standorten),
 * Cookie-Banner (Consent Mode v2) und GTM-Vorbereitung.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site, locations, serviceAreas } from '../data/site';
import { services } from '../data/services';
import ogDefault from '../assets/images/team-stimmung.png';

export interface Props {
  title: string;
  description: string;
  /** Pfad ohne Domain, z. B. "/leistungen/bueroreinigung" */
  canonical?: string;
  ogImage?: ImageMetadata;
  noindex?: boolean;
  /** Zusätzliche JSON-LD-Objekte (z. B. FAQPage, Service, JobPosting) */
  schema?: Record<string, unknown>[];
  /** Mobile CTA-Leiste ausblenden (z. B. Rechtstexte) */
  hideMobileBar?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage = ogDefault,
  noindex = false,
  schema = [],
  hideMobileBar = false,
} = Astro.props;

const siteUrl = (Astro.site?.toString() ?? site.url).replace(/\/$/, '');
const canonicalPath = canonical === '/index' ? '/' : canonical.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonicalUrl = `${siteUrl}${canonicalPath === '/' ? '/' : canonicalPath}`;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, siteUrl).toString();

const gtmId = import.meta.env.PUBLIC_GTM_ID || '';

/* ---------- Schema.org: Organisation + beide Standorte ---------- */
const isPlaceholder = (v: string) => v.trim().startsWith('[');
const postalAddress = (loc: (typeof locations)[number]) => ({
  '@type': 'PostalAddress',
  ...(isPlaceholder(loc.street) ? {} : { streetAddress: loc.street }),
  ...(isPlaceholder(loc.zip) ? {} : { postalCode: loc.zip }),
  addressLocality: loc.city,
  addressRegion: loc.region,
  addressCountry: 'DE',
});

const orgId = `${siteUrl}/#organization`;
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: site.name,
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
      email: site.email,
      telephone: site.phone.e164,
      contactPoint: [
        { '@type': 'ContactPoint', telephone: site.phone.e164, contactType: 'sales', areaServed: 'DE', availableLanguage: ['de'] },
      ],
      sameAs: [],
    },
    ...locations.map((loc) => ({
      '@type': 'LocalBusiness',
      '@id': `${siteUrl}/#${loc.id}`,
      name: `${site.name} – ${loc.label}`,
      parentOrganization: { '@id': orgId },
      url: siteUrl,
      telephone: site.phone.e164,
      email: site.email,
      image: ogUrl,
      address: postalAddress(loc),
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '07:00',
        closes: '18:00',
      },
      priceRange: '€€',
      ...(loc.isPrimary
        ? {
            areaServed: serviceAreas.map((city) => ({ '@type': 'City', name: city })),
            hasOfferCatalog: {
              '@type': 'OfferCatalog',
              name: 'Gebäudereinigung',
              itemListElement: services.map((s) => ({
                '@type': 'Offer',
                itemOffered: { '@type': 'Service', name: s.name, url: `${siteUrl}/leistungen/${s.slug}` },
              })),
            },
          }
        : {}),
    })),
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: site.name,
      publisher: { '@id': orgId },
      inLanguage: 'de-DE',
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#13203b" />
    <meta name="generator" content={Astro.generator} />

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Tag Manager – Vorbereitung. Geladen wird der Container erst nach
         Einwilligung durch public/js/consent.js (Consent Mode v2). Ohne GTM-ID
         in .env passiert hier nichts. -->
    {gtmId && <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />}
    {gtmId && <meta name="gtm-container" content={gtmId} />}

    <!-- Konfiguration + Einwilligung – Reihenfolge wichtig, KEIN defer -->
    <script is:inline src="/js/config.js"></script>
    <script is:inline src="/js/consent.js"></script>

    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-navy-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Zum Inhalt springen
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
    {!hideMobileBar && <MobileCtaBar />}
    <CookieConsent />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
